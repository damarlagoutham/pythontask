#11 String Formatting
def print_formatted(number):
    # your code goes here
    s=len(bin(number)[2:])
    for i in range(1,number+1):
        a=str(i)
        b=str(oct(i)[2:])
        c=str(hex(i)[2:])
        d=str(bin(i)[2:])
        print(a.rjust(s," "),b.rjust(s," "),c.rjust(s," ").upper(),d.rjust(s," "))

if __name__ == '__main__':
    n = int(input())
    print_formatted(n)
